# ==============================================================================
# MYRAA BACKEND — LOCAL DEVELOPMENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Gemini API Key for local development
GEMINI_API_KEY=AIzaSy_YOUR_LOCAL_GEMINI_API_KEY_HERE

# Models
GEMINI_LIVE_MODEL=gemini-2.5-flash
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Optional local secrets
# POLICY_SIGNING_SECRET=
# MYRAA_MASTER_KEY=
# SORA_REMOTE_SECRET=
