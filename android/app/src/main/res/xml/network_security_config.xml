<?xml version="1.0" encoding="utf-8"?>
<!--
  MYRAA Android Companion — Production Network Security Configuration
  Phase 12 — Release Packaging & Production Hardening

  SECURITY POLICY:
  - Cleartext HTTP/WS traffic is globally PROHIBITED (cleartextTrafficPermitted="false").
  - All production REST and WebSocket connections must use TLS (HTTPS / WSS).
  - Trusts only the Android system CA store (no user-installed or debug CAs).
  - Zero development or LAN cleartext domain exceptions in production release builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

