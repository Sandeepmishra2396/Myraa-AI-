<?xml version="1.0" encoding="utf-8"?>
<!--
  MYRAA Android Companion — AndroidManifest.xml
  Phase 15: Permission declarations + component stubs

  This manifest declares all permissions and service types needed for:
    1. Full-duplex live audio streaming to MYRAA Desktop Core
    2. Persistent foreground connection (prevents OS from killing audio session)
    3. Local network discovery (mDNS / NSD) for desktop auto-discovery
    4. Notification posting (Emergency Stop alerts, companion notifications)
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════════════════
         NETWORK PERMISSIONS
         Required for WebSocket streaming to MYRAA Core on local Wi-Fi network.
         ═══════════════════════════════════════════════════════════════════════ -->

    <!-- TCP/IP connectivity to MYRAA Core over local LAN or internet -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- NSD (Network Service Discovery) for auto-discovering MYRAA desktop host -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         AUDIO PERMISSIONS
         Required for 16kHz PCM16 microphone capture (Gemini Live input stream).
         ═══════════════════════════════════════════════════════════════════════ -->

    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         FOREGROUND SERVICE PERMISSIONS
         Required to keep the live audio session alive while the app is in background.
         Android 14+ (API 34+) requires explicit foreground service type declarations.
         ═══════════════════════════════════════════════════════════════════════ -->

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- FOREGROUND_SERVICE_MICROPHONE: Declared for Android 14+ (API 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- POST_NOTIFICATIONS: Required on Android 13+ (API 33+) for notification posting -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- VIBRATE: For Emergency Stop haptic alert feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- WAKE_LOCK: Prevent CPU sleep during active audio streaming session -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         CAMERA PERMISSION (Phase 18 — Camera Streaming)
         Declared now; runtime permission requested only when feature is used.
         ═══════════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ═══════════════════════════════════════════════════════════════════════
         PHASE 19 CAPABILITY PERMISSIONS
         ═══════════════════════════════════════════════════════════════════════ -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Package visibility declarations for Android 11+ (API 30+) -->
    <queries>
        <package android:name="com.google.android.gm" />
        <package android:name="com.android.chrome" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="com.google.android.calendar" />
        <package android:name="com.google.android.deskclock" />
        <package android:name="com.android.deskclock" />
        <package android:name="com.android.settings" />
        <!-- Phase 21: WhatsApp app interaction -->
        <package android:name="com.whatsapp" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
        <!-- Phase 21: Gmail compose via mailto: scheme -->
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <!-- Phase 21: Google Maps geo: and navigation: deep links -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <!-- Phase 21: Calendar event insertion -->
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
    </queries>
    <uses-feature android:name="android.hardware.microphone" android:required="true" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      Network Security Config: Restricts cleartext HTTP/WS strictly to local LAN
      development targets. Production connections require TLS (WSS/HTTPS).
      See res/xml/network_security_config.xml for full policy specification.
    -->
    <application
        android:name=".MyraaApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyraaCompanion"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <!--
          MainActivity — Placeholder for Phase 17 (Jetpack Compose UI).
          Kotlin source to be added in Phase 16/17.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyraaCompanion.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          LiveAudioForegroundService — Maintains active /remote-live WebSocket
          connection and PCM audio streaming while the app is backgrounded.
          Type "microphone" is required on API 34+ for foreground audio recording.
          Kotlin source to be added in Phase 16.
        -->
        <service
            android:name=".service.LiveAudioForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>

</manifest>
