# ==============================================================================
# MYRAA BACKEND — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or inject these environment variables into your
# production container / orchestration environment (Docker, Kubernetes, systemd).
#
# IMPORTANT:
# - In production (NODE_ENV=production), API key mutations via HTTP are forbidden.
# - Secrets are loaded strictly from the server environment.
# - Non-localhost callers must connect over HTTPS / WSS.
# ==============================================================================

# Server Runtime Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Google Gemini API Credentials (Loaded strictly from server environment)
# ------------------------------------------------------------------------------
# The primary Gemini API key used by the backend for Gemini Live & multimodal tasks.
# Can also be set as GOOGLE_API_KEY or GOOGLE_GENAI_API_KEY.
GEMINI_API_KEY=AIzaSy_YOUR_PRODUCTION_GEMINI_API_KEY_HERE

# Gemini Model Definitions
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_TEXT_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Security & Cryptographic Keys
# ------------------------------------------------------------------------------
# 64-character hex string used for HMAC-SHA256 signing of security policies (Phase 10E/28)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POLICY_SIGNING_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 64-character hex string used as the master encryption key for remote device credentials (AES-256-GCM)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MYRAA_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Cryptographic shared secret used during remote pairing code exchange and validation
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SORA_REMOTE_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ------------------------------------------------------------------------------
# Network & Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Explicit comma-separated list of permitted origin URLs.
# In production, wildcards (*) are rejected. Requests from unlisted origins are blocked.
CORS_ORIGINS=https://myraa.yourdomain.com,https://app.yourdomain.com

# ------------------------------------------------------------------------------
# Storage & Data Directory
# ------------------------------------------------------------------------------
# Persistent storage directory for SQLite/JSON databases, memories, paired devices, and logs.
# Defaults to "./data" relative to the project directory if unspecified.
# In Docker/Kubernetes, point this to a mounted persistent volume.
SORA_DATA_DIR=/var/lib/myraa/data

# ------------------------------------------------------------------------------
# Optional Native TLS / HTTPS Configuration
# ------------------------------------------------------------------------------
# If running behind an HTTPS reverse proxy (Nginx, Caddy, Cloudflare, AWS ALB),
# leave these unset. The reverse proxy will handle TLS termination and forward
# X-Forwarded-Proto: https and X-Forwarded-For headers.
# If running standalone Node.js directly on public port 443, provide absolute paths:
# MYRAA_TLS_CERT=/etc/ssl/certs/fullchain.pem
# MYRAA_TLS_KEY=/etc/ssl/private/privkey.pem

# ------------------------------------------------------------------------------
# Optional Co-located Desktop Agent
# ------------------------------------------------------------------------------
# URL for the co-located Python desktop automation worker (if enabled).
# DESKTOP_AGENT_URL=http://127.0.0.1:8765
