# ═══════════════════════════════════════════════════════════════════════════════
# MYRAA Production Environment Configuration Template
# Phase 30 — Production Hardening & Release Readiness
# ═══════════════════════════════════════════════════════════════════════════════

# Environment mode — strictly "production" for production deployments
NODE_ENV=production

# Server listener port (default: 3000)
PORT=3000

# Server host interface (0.0.0.0 listens on all interfaces)
HOST=0.0.0.0

# Gemini API Key (Server authoritative key from secrets.json or environment)
# Never commit real keys to version control!
GEMINI_API_KEY=""

# Production CORS Whitelist: Comma-separated list of explicit allowed web origins
# No wildcard '*' is permitted in production mode!
# Example: https://app.myraa.ai,https://admin.myraa.ai
CORS_ORIGINS="https://app.myraa.ai"

# TLS / HTTPS Configuration:
# Required for non-localhost WebSocket and REST transport security.
# Paths to PEM-encoded certificate and private key.
# MYRAA_TLS_CERT="/path/to/fullchain.pem"
# MYRAA_TLS_KEY="/path/to/privkey.pem"

# Android Release Signing Credentials (for CI/CD build environments):
# MYRAA_RELEASE_KEYSTORE_PATH="/path/to/production-release-keystore.jks"
# MYRAA_RELEASE_STORE_PASSWORD=""
# MYRAA_RELEASE_KEY_ALIAS="myraa_release_key"
# MYRAA_RELEASE_KEY_PASSWORD=""
